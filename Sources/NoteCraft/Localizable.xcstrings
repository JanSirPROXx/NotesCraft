    "An item with this name already exists. Nothing was replaced.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Objekt mit diesem Namen existiert bereits. Es wurde nichts ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un elemento con este nombre. No se ha reemplazado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément portant ce nom existe déjà. Rien n’a été remplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un elemento con questo nome. Non è stato sostituito nulla."
          }
        }
      }
    },
    "An open canvas with two-finger pan and pinch zoom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine offene Fläche zum Verschieben mit zwei Fingern und Zoomen per Pinch-Geste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lienzo abierto con desplazamiento a dos dedos y zoom de pellizco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace libre à déplacer à deux doigts et à zoomer par pincement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tela aperta da spostare con due dita e ingrandire con il pizzico."
          }
        }
      }
    },
    "Animation: 12 × 3 = is written, lights up, and 36 appears next to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation: 12 × 3 = wird geschrieben, leuchtet auf, und daneben erscheint 36."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Animación: se escribe 12 × 3 =, se ilumina y aparece 36 al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation : 12 × 3 = s’écrit, s’illumine, et 36 apparaît à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Animazione: viene scritto 12 × 3 =, si illumina e accanto compare 36."
          }
        }
      }
    },
