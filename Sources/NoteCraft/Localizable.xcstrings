          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página es un PDF, así que su fondo se conserva. Activa «Aplicar a todas las páginas que no son PDF» para cambiar las demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page est un PDF ; son fond reste donc inchangé. Activez « Appliquer à toutes les pages non PDF » pour modifier les autres."
