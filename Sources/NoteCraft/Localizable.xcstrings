    "Tap the page to place a shape, or drag to size it. Then drag, stretch or rotate it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Seite, um eine Form zu platzieren, oder ziehe sie auf. Danach kannst du sie bewegen, dehnen oder drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la página para colocar una forma, o arrastra para darle tamaño. Luego puedes moverla, estirarla o girarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la page pour placer une forme, ou faites glisser pour la dimensionner. Vous pouvez ensuite la déplacer, l’étirer ou la faire pivoter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la pagina per inserire una forma, oppure trascina per dimensionarla. Poi puoi spostarla, allungarla o ruotarla."
          }
        }
      }
    },
    "Tap the page to type a text box.": {
