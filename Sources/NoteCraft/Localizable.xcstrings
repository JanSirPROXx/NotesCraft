    "A theme is a folder ending in .notecrafttheme with a theme.json, and the fonts and icons it names. Swipe an added theme to remove it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Theme ist ein Ordner mit der Endung .notecrafttheme, einer theme.json und den darin genannten Schriften und Symbolen. Wische über ein hinzugefügtes Theme, um es zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema es una carpeta que termina en .notecrafttheme con un theme.json, y las fuentes e iconos que nombra. Desliza un tema añadido para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un thème est un dossier se terminant par .notecrafttheme, avec un fichier theme.json et les polices et icônes qu’il cite. Balayez un thème ajouté pour le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema è una cartella che termina con .notecrafttheme, con un theme.json e i font e le icone che indica. Scorri su un tema aggiunto per rimuoverlo."
          }
        }
      }
    },
