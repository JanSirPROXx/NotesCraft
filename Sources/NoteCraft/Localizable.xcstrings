    "All %lld items will be permanently deleted. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Objekte werden endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld elementos se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld éléments seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i %lld elementi verranno eliminati definitivamente. L’operazione non può essere annullata."
          }
        }
      }
    },
