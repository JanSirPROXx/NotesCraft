    "Infinite scrolling is one long sheet that grows as you write, so pages do not turn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Scrollen ist ein langes Blatt, das beim Schreiben wächst, daher wird nicht umgeblättert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento infinito es una hoja larga que crece mientras escribes, por lo que las páginas no se pasan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défilement infini est une longue feuille qui grandit à mesure que vous écrivez ; les pages ne se tournent donc pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento infinito è un unico foglio lungo che cresce mentre scrivi, quindi le pagine non si girano."
          }
        }
      }
    },
