          "stringUnit": {
            "state": "translated",
            "value": "« %@ » dans le pack est endommagé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» nel pacchetto è danneggiato."
          }
        }
      }
    },
    "“%@” is a kind of file a theme cannot hold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist eine Dateiart, die ein Theme nicht enthalten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es un tipo de archivo que un tema no puede contener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un type de fichier qu’un thème ne peut pas contenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è un tipo di file che un tema non può contenere."
          }
        }
      }
    },
    "“%@” is not a valid theme id (lowercase letters, digits, dots, dashes; 3 to 64 characters).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist keine gültige Theme-ID (Kleinbuchstaben, Ziffern, Punkte, Bindestriche; 3 bis 64 Zeichen)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un id de tema válido (minúsculas, dígitos, puntos, guiones; de 3 a 64 caracteres)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un identifiant de thème valide (minuscules, chiffres, points, tirets ; 3 à 64 caractères)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non è un id di tema valido (lettere minuscole, cifre, punti, trattini; da 3 a 64 caratteri)."
          }
        }
      }
    },
    "“%@” is not here any more.": {
