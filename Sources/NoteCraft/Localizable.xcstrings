    "“%@” belongs to the themes that come with the app. Choose another id.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ gehört zu den Themes, die mit der App kommen. Wähle eine andere ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» pertenece a los temas que vienen con la app. Elige otro id."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » fait partie des thèmes fournis avec l’app. Choisissez un autre identifiant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» appartiene ai temi inclusi con l’app. Scegli un altro id."
          }
        }
      }
    },
    "“%@” in the pack is damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ im Paket ist beschädigt."
          }
