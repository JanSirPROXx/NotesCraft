    "NotesCraft": {
      "shouldTranslate": false
    },
    "NotesCraft uses the language of this iPad unless you choose one here. What the system itself shows, such as the file picker, always follows the iPad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NotesCraft verwendet die Sprache dieses iPads, sofern du hier keine andere wählst. Was das System selbst anzeigt, etwa die Dateiauswahl, folgt immer dem iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NotesCraft usa el idioma de este iPad, a menos que elijas otro aquí. Lo que muestra el propio sistema, como el selector de archivos, siempre sigue al iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotesCraft utilise la langue de cet iPad, sauf si vous en choisissez une ici. Ce que le système affiche lui-même, comme le sélecteur de fichiers, suit toujours l’iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NotesCraft usa la lingua di questo iPad, a meno che tu non ne scelga una qui. Ciò che mostra il sistema stesso, come il selettore di file, segue sempre l’iPad."
          }
        }
      }
    },
