        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero una carpeta de almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’abord un dossier de stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima una cartella di archiviazione."
          }
        }
      }
    },
