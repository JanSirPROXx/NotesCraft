    "Text fields, choices and checkboxes are supported. Signature and radio fields need another PDF editor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textfelder, Auswahlfelder und Ankreuzfelder werden unterstützt. Signatur- und Optionsfelder benötigen einen anderen PDF-Editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se admiten campos de texto, opciones y casillas. Los campos de firma y de opción necesitan otro editor de PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs de texte, les choix et les cases à cocher sont pris en charge. Les champs de signature et les boutons radio nécessitent un autre éditeur PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono supportati campi di testo, scelte e caselle di controllo. I campi firma e i pulsanti di opzione richiedono un altro editor PDF."
          }
        }
      }
    },
    "The .%@ extension is kept automatically.": {
