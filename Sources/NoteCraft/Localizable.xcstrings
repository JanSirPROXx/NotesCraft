    "Fast GPU ink": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle GPU-Tinte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinta GPU rápida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encre GPU rapide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inchiostro GPU veloce"
          }
        }
      }
    },
    "Fast GPU ink draws the line you are writing on the GPU for the lowest latency. What a double tap or squeeze of the Pencil does follows Settings ▸ Apple Pencil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schnelle GPU-Tinte zeichnet die Linie, die du gerade schreibst, auf der GPU, für die geringste Latenz. Was ein Doppeltippen oder Drücken des Pencils bewirkt, folgt den Einstellungen ▸ Apple Pencil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tinta GPU rápida dibuja en la GPU el trazo que escribes, para la mínima latencia. Lo que hacen el doble toque o la pulsación del Pencil sigue Ajustes ▸ Apple Pencil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’encre GPU rapide dessine le trait en cours sur le GPU pour une latence minimale. Ce que font un double toucher ou une pression du Pencil suit Réglages ▸ Apple Pencil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inchiostro GPU veloce disegna sulla GPU il tratto che stai scrivendo, per la latenza più bassa. Ciò che fanno il doppio tocco o la pressione della Pencil segue Impostazioni ▸ Apple Pencil."
          }
        }
      }
    },
