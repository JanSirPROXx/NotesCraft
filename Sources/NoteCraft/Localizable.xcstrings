    "Enter the password to create an unlocked PDF copy in the same folder. Your encrypted original stays unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Passwort ein, um eine entsperrte PDF-Kopie im selben Ordner zu erstellen. Dein verschlüsseltes Original bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la contraseña para crear una copia desbloqueada del PDF en la misma carpeta. El original cifrado no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mot de passe pour créer une copie PDF déverrouillée dans le même dossier. Votre original chiffré reste inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password per creare una copia PDF sbloccata nella stessa cartella. L’originale cifrato resta invariato."
